echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo UmVkIH0NCiAgICB9DQp9>>"%TMPB64%"

powershell -NoProfile -ExecutionPolicy Bypass -Command "try { $b64 = (Get-Content -Raw -LiteralPath $env:TMPB64) -replace '\s',''; [IO.File]::WriteAllBytes($env:TMPPS1, [Convert]::FromBase64String($b64)) } catch { Write-Host ('Failed to decode internal script: ' + $_.Exception.Message); exit 1 }"

del "%TMPB64%" >nul 2>nul

if not exist "%TMPPS1%" (
  echo.
  echo ERROR: internal script was not created. PowerShell may be blocked.
  echo.
  pause
  exit /b
)

powershell -NoProfile -ExecutionPolicy Bypass -File "%TMPPS1%"
set "RC=%ERRORLEVEL%"

del "%TMPPS1%" >nul 2>nul

if not "%RC%"=="0" (
  echo.
  echo Exit code %RC% - something went wrong, pausing so you can read the message above.
  echo.
  pause
)
