@echo off
setlocal

set "TMPPS1=%~dp0__run_lag_temp.ps1"
set "TMPB64=%~dp0__run_lag_temp.b64"

echo Preparing...

if exist "%TMPB64%" del "%TMPB64%" >nul 2>nul
if exist "%TMPPS1%" del "%TMPPS1%" >nul 2>nul

echo >"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
echo >>"%TMPB64%"
